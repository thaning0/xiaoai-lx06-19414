+# Preserve a paired stock config on the first open-audio boot. Never overwrite
+# an existing custom config, including an empty file or a dangling symlink.
+migrate_wireless_conf()
+{
+    [ -e "$WIRELESS_CONF" ] || [ -L "$WIRELESS_CONF" ] || {
+        local legacy="/data/wifi/wpa.conf"
+        [ -f "$legacy" ] && [ -s "$legacy" ] || {
+            wireless_log "No nonempty legacy Wi-Fi config; refusing blank configuration"
+            return 1
+        }
+        local temporary="${WIRELESS_CONF}.migrate.$$"
+        (umask 077; set -C; cat "$legacy" > "$temporary") &&
+            chmod 600 "$temporary" &&
+            ln "$temporary" "$WIRELESS_CONF" || {
+                rm -f "$temporary"
+                wireless_log "Wi-Fi config migration failed"
+                return 1
+            }
+        rm -f "$temporary"
+    }
+    [ -f "$WIRELESS_CONF" ] && [ -s "$WIRELESS_CONF" ] || {
+        wireless_log "Wi-Fi config missing or empty; refusing blank configuration"
+        return 1
+    }
+}
